{
  "name": "mark-attest",
  "version": "0.1.0",
  "description": "Checks whether a candidate name looks like an existing registered trademark or a known AI/crypto project name — a cheap, early signal before you launch, not a legal verdict. Part of the tokenizen -attest family (see capacity-attest).",
  "keywords": [
    "trademark",
    "name-collision",
    "brand-monitoring",
    "ai-agent",
    "x402"
  ],
  "author": "holistis",
  "license": "MIT",
  "homepage": "https://tokenizen.nl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holistis/tokenizen.git",
    "directory": "packages/mark-attest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
