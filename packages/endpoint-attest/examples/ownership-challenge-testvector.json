      "activeTestConsentToken": "consent_d5ef3161a73d67ba0d44cade1f16ea8adcdb60d9fd535006db359a546b3e2bef"
    },
    {
      "name": "root-path-keeps-its-slash",
      "endpoint": "https://mcp.example.com/",
      "ownerAddress": "0x1111111111111111111111111111111111111111",
      "normalizedEndpoint": "https://mcp.example.com/",
      "ownershipToken": "tok_58b03e5b598b81539231b6553b40f599f16293f82cc905cc34a372d75b2223f5",
      "activeTestConsentToken": "consent_8f1746409afb652bbfd3a5e7a8230d17390c77d7c03d2a1ecba229c928284ffe"
    }
  ]
}
