{
  "name": "self-check-server",
  "version": "0.1.0",
  "private": true,
  "description": "Small HTTP backend behind tokenizen.nl/check: a browser cannot call node:dns/node:crypto directly, so this thin Express layer exposes the already-tested endpoint-attest/trust-attest-server ownership-proof functions (challenge + verify) over two routes, with SSRF-guarded outbound requests and per-IP rate limiting for public, unauthenticated use.",
  "author": "holistis",
  "license": "MIT",
  "homepage": "https://tokenizen.nl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holistis/tokenizen.git",
    "directory": "packages/self-check-server"
  },
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "trust-attest-server": "^0.1.0",
    "endpoint-attest": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
